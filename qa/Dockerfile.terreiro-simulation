# Laboratory dependencies only; no external AI or pretrained weights.
FROM localauthor-code-repair-lab:1
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip \
    && python3 -m pip install --break-system-packages --no-cache-dir Pillow==11.3.0 pypdf==6.0.0 \
    && rm -rf /var/lib/apt/lists/*
USER 10001:10001
